# ==========================================
# Wedding Moments Configuration
# ==========================================

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# ==========================================
# Google Drive API Configuration
# ==========================================
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Refresh Token for the owner's Google account to upload photos directly to Google Drive
# (Obtain via Google OAuth Playground or service authorization)
GOOGLE_REFRESH_TOKEN=""

# Dedicated Google Drive Folder ID where all original high-resolution wedding photos will be stored
# (The ID can be copied from the URL when viewing the folder in Google Drive: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"

# ==========================================
# Storage Fallback & Upload Limits
# ==========================================
# If set to "true", the app stores uploads locally in .data/ when Google Drive credentials are not yet set.
ENABLE_LOCAL_STORAGE_FALLBACK="true"

# Maximum file size per photo in Megabytes (e.g., 25MB)
MAX_FILE_SIZE_MB="25"

# Maximum files allowed per single upload request
MAX_FILES_PER_UPLOAD="10"

# Rate Limiting: Max upload requests per IP per minute
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="20"
